<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'unsafe-inline'; img-src data: blob:; media-src blob:; base-uri 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Update — Prototype</title>
<link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Caveat+Brush&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff;--card:#fff;--card2:#f4f4f6;--card3:#ececed;--border:#dcdce0;--divider:#e6e6e9;--text:#111113;--dim:#5c5c62;--faint:#8c8c92;--red:#e0432c;--blue:#2f6fed;--pink:#e23a56;--ink:#0b0b0d;--tint:#eef0f6;}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;}
body{background:var(--bg);color:var(--text);min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;}
button,input,textarea{font-family:inherit;}
svg{display:block;}
.shell{width:390px;max-width:100vw;margin:0 auto;height:100vh;height:100dvh;background:var(--bg);position:relative;display:flex;flex-direction:column;overflow:hidden;}
#scr{flex:1;min-height:0;display:flex;flex-direction:column;}
.top{flex-shrink:0;background:#fff;position:relative;z-index:20;}
.feed,.page{flex:1;min-height:0;overflow-y:auto;padding:0 0 84px;scrollbar-width:none;}
.feed::-webkit-scrollbar,.page::-webkit-scrollbar{display:none;}
.spacer{flex:1;}
/* header */
.head{display:flex;align-items:center;gap:8px;padding:calc(4px + env(safe-area-inset-top,0px)) 14px 4px;}
.logo{position:relative;line-height:1;}
.logo .word{font-family:'Permanent Marker','Caveat Brush','Brush Script MT',cursive;font-size:33px;font-style:italic;color:var(--ink);letter-spacing:-.02em;transform:skewX(-4deg);display:block;}
.logo .swoosh{position:absolute;left:4px;right:0;bottom:-3px;height:4px;border-radius:3px;background:var(--blue);}
.tag{font-size:10.5px;color:var(--faint);font-weight:500;display:flex;gap:7px;margin-top:6px;white-space:nowrap;}
.tag i{font-style:normal;}
.topg{display:flex;align-items:center;gap:7px;background:var(--ink);color:#fff;border-radius:18px;padding:8px 10px 8px 12px;font-size:14px;font-weight:800;cursor:pointer;}
.hbtn{width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:var(--ink);cursor:pointer;}
.hbtn.blue{color:var(--blue);}
/* page header */
.phd{display:flex;align-items:center;gap:10px;padding:calc(8px + env(safe-area-inset-top,0px)) 14px 8px;}
.phd .ttl{font-size:21px;font-weight:800;letter-spacing:-.01em;display:flex;align-items:center;gap:8px;}
.phd .sub{font-size:11.5px;color:var(--faint);font-weight:500;margin-top:1px;}
.iconbtn{width:34px;height:34px;border-radius:50%;background:var(--card2);display:flex;align-items:center;justify-content:center;border:1px solid var(--border);color:var(--text);flex-shrink:0;cursor:pointer;}
.btn{border:none;border-radius:12px;padding:10px 16px;font-size:13px;font-weight:700;cursor:pointer;background:var(--ink);color:#fff;text-align:center;}
.btn.blue{background:var(--blue);}
.btn.line{background:var(--card2);color:var(--text);border:1px solid var(--border);}
.btn.off{opacity:.35;pointer-events:none;}
/* stories */
.stories{display:flex;gap:11px;overflow-x:auto;padding:4px 14px 6px;scrollbar-width:none;}
.stories::-webkit-scrollbar{display:none;}
.story{flex-shrink:0;width:62px;text-align:center;cursor:pointer;}
.ring{width:58px;height:58px;border-radius:50%;padding:2px;background:var(--ink);margin:0 auto;}
.ring .in{width:100%;height:100%;border-radius:50%;border:2.5px solid #fff;overflow:hidden;background:var(--card2);}
.ring .in svg{width:100%;height:100%;}
.story .nm{font-size:10.5px;font-weight:600;margin-top:3px;white-space:nowrap;}
/* chips */
.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 14px 8px;scrollbar-width:none;}
.chips::-webkit-scrollbar{display:none;}
.chip{flex-shrink:0;padding:7px 15px;border-radius:18px;background:var(--tint);border:1px solid var(--tint);font-size:13px;font-weight:500;color:var(--text);cursor:pointer;}
.chip.active{background:var(--ink);border-color:var(--ink);color:#fff;font-weight:700;display:flex;align-items:center;gap:6px;position:relative;}
.chip.loc.active::after{content:'';position:absolute;left:30px;right:10px;bottom:4px;height:2px;border-radius:2px;background:var(--blue);}
/* posts */
.post{padding:10px 14px 8px;border-bottom:6px solid #f1f2f5;}
.phead{display:flex;align-items:center;gap:9px;margin-bottom:8px;}
.pav{border-radius:14px;overflow:hidden;flex-shrink:0;background:var(--ink);display:flex;align-items:center;justify-content:center;color:#fff;}
.pav.round{border-radius:50%;}
.pav svg{width:100%;height:100%;}
.pmeta{flex:1;min-width:0;}
.pname{display:flex;align-items:center;gap:5px;font-size:15px;font-weight:800;cursor:pointer;}
.pname .t{font-size:12px;font-weight:500;color:var(--faint);margin-left:4px;}
.pname .tg{font-size:9.5px;font-weight:800;background:var(--ink);color:#fff;border-radius:6px;padding:2px 6px;margin-left:2px;}
.sm .pname{font-size:14px;}
.pseen{font-size:12px;color:var(--faint);margin-top:1px;}
.sm .pseen{font-size:12px;}
.dots{display:flex;gap:3px;padding:6px;}
.dots span{width:5px;height:5px;border-radius:50%;background:var(--ink);}
.media{position:relative;width:100%;aspect-ratio:2.05/1;border-radius:14px;overflow:hidden;border:1px solid var(--border);}
.m1{background:linear-gradient(180deg,#2c2766 0%,#3a2f86 55%,#231f55 100%);}
.m1::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(0,0,0,.18) 0 10px,rgba(255,255,255,.04) 10px 22px);}
.play{position:absolute;left:10px;top:10px;background:rgba(11,11,13,.82);color:#fff;border-radius:16px;padding:6px 12px 6px 10px;font-size:12px;font-weight:700;display:flex;align-items:center;gap:6px;z-index:3;}
.sticker{position:absolute;right:8px;top:8px;z-index:3;background:var(--ink);color:#fff;padding:7px 12px 6px;font-family:'Permanent Marker','Caveat Brush',cursive;font-size:14px;line-height:1.05;transform:rotate(-8deg);border-radius:4px 10px 4px 12px;}
.sticker svg{position:absolute;right:2px;top:2px;color:var(--blue);}
.sticker u{display:block;height:2px;background:#fff;border-radius:2px;margin-top:2px;width:70%;}
.cap{position:absolute;left:12px;bottom:12px;z-index:3;font-family:'Permanent Marker','Caveat Brush',cursive;font-size:19px;line-height:1.1;color:#fff;transform:rotate(-5deg);transform-origin:left bottom;text-shadow:0 2px 6px rgba(0,0,0,.55);}
.cap u{display:block;height:3px;background:var(--blue);border-radius:3px;margin-top:3px;}
.note{position:absolute;right:10px;bottom:12px;z-index:3;width:104px;background:#f7f6f2;border:1px solid #e5e2da;padding:8px 9px;font-family:'Caveat Brush','Permanent Marker',cursive;font-size:13px;line-height:1.1;color:var(--ink);transform:rotate(-7deg);box-shadow:0 2px 8px rgba(0,0,0,.25);}
.note u{display:block;height:2px;background:var(--blue);border-radius:2px;margin-top:3px;}
.people{position:absolute;inset:0;z-index:1;width:100%;height:100%;}
.m2{background:linear-gradient(180deg,#e7d9c6 0%,#d9c6ab 60%,#cdb594 100%);}
.m2 .lamp{position:absolute;right:30%;top:20%;width:46px;height:46px;border-radius:50%;background:#f3e1c0;border:1px solid #e0c99d;}
.m2 .win{position:absolute;right:0;top:0;width:34%;height:100%;background:linear-gradient(90deg,#c9a77f,#e1c6a0);opacity:.7;}
.pill{position:absolute;right:8px;top:10px;z-index:3;background:var(--ink);color:#fff;border-radius:16px;padding:7px 10px 7px 11px;font-size:12px;font-weight:600;display:flex;align-items:center;gap:6px;}
.m3{background:linear-gradient(135deg,#17171d,#2a2a35);display:flex;align-items:center;padding:18px 18px 22px;}
.m3 .tx{font-family:'Permanent Marker','Caveat Brush',cursive;font-size:21px;line-height:1.2;color:#fff;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word;}
.m3 u{position:absolute;left:18px;bottom:12px;width:64px;height:3px;border-radius:3px;background:var(--blue);}
.media img,.media video{width:100%;height:100%;object-fit:cover;display:block;}
.ptitle{font-size:15.5px;font-weight:800;margin:8px 0 0;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.psub{font-size:14px;font-weight:500;color:var(--dim);margin:1px 0 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.acts{display:flex;align-items:center;gap:20px;margin-top:6px;}
.act{display:flex;align-items:center;gap:6px;font-size:15px;font-weight:700;cursor:pointer;}
.act svg{color:var(--ink);}
.gift{font-size:23px;line-height:1;}
.right{margin-left:auto;display:flex;align-items:center;gap:16px;}
/* lists */
.card{background:var(--card2);border:1px solid var(--border);border-radius:16px;margin:0 16px 14px;overflow:hidden;}
.row{display:flex;align-items:center;gap:12px;padding:12px 14px;border-bottom:1px solid var(--divider);cursor:pointer;}
.row:last-child{border-bottom:none;}
.row .info{flex:1;min-width:0;}
.row .t1{font-size:14px;font-weight:800;display:flex;align-items:center;gap:5px;}
.row .t2{font-size:11.5px;color:var(--faint);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.row .side{font-size:11.5px;font-weight:700;color:var(--dim);flex-shrink:0;}
.sec{display:flex;justify-content:space-between;padding:10px 20px 8px;font-size:11px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--faint);}
.sinput{flex:1;display:flex;align-items:center;gap:8px;background:var(--tint);border:1px solid var(--border);border-radius:22px;padding:10px 14px;color:var(--blue);}
.sinput input{flex:1;background:none;border:none;outline:none;font-size:14px;color:var(--text);}
.sinput input::placeholder{color:var(--faint);}
.empty{padding:36px 24px;text-align:center;color:var(--faint);font-size:12.5px;}
/* profile */
.pbanner{display:flex;align-items:center;gap:14px;padding:6px 16px 12px;}
.pbanner .nm{font-size:20px;font-weight:800;display:flex;align-items:center;gap:6px;}
.pbanner .hd{font-size:12px;color:var(--dim);margin-top:2px;}
.badge{display:inline-block;font-size:10px;font-weight:800;padding:3px 8px;border-radius:6px;background:var(--ink);color:#fff;margin-top:6px;}
.stats{display:flex;gap:9px;padding:0 16px;margin-bottom:12px;}
.stat{flex:1;background:var(--card2);border:1px solid var(--border);border-radius:14px;padding:12px 8px;text-align:center;}
.stat .v{font-size:17px;font-weight:800;}.stat .l{font-size:10px;color:var(--faint);margin-top:3px;font-weight:600;}
.bio{margin:0 16px 12px;background:var(--card2);border:1px solid var(--border);border-radius:14px;padding:14px;font-size:12.5px;line-height:1.55;color:var(--dim);}
.pbtns{display:flex;gap:8px;padding:0 16px 8px;}.pbtns .btn{flex:1;}
/* compose */
.compose{margin:0 16px;}
.compose textarea{width:100%;min-height:96px;resize:none;border:1px solid var(--border);background:var(--tint);border-radius:16px;padding:14px;font-size:15px;outline:none;color:var(--text);}
.compose textarea::placeholder{color:var(--faint);}
.drop{aspect-ratio:1.97/1;border:1.5px dashed var(--border);border-radius:16px;margin-top:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:var(--dim);font-size:13px;font-weight:600;cursor:pointer;background:var(--card2);position:relative;overflow:hidden;}
.drop input{display:none;}
.rm{position:absolute;right:8px;top:8px;z-index:4;}
.note2{font-size:11.5px;color:var(--faint);padding:6px 20px 0;line-height:1.5;}
/* sheet & toast */
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.38);z-index:90;display:flex;align-items:flex-end;justify-content:center;}
.sheet{width:390px;max-width:100vw;background:#fff;border-radius:24px 24px 0 0;padding:14px 18px 26px;}
.grab{width:40px;height:4px;border-radius:2px;background:var(--border);margin:0 auto 14px;}
.amt{display:flex;align-items:center;gap:8px;background:var(--tint);border:1px solid var(--border);border-radius:16px;padding:12px 14px;margin:14px 0 10px;font-size:20px;font-weight:800;}
.amt input{flex:1;border:none;background:none;outline:none;font-size:20px;font-weight:800;color:var(--text);min-width:0;}
.amt input::placeholder{color:var(--faint);font-weight:600;font-size:16px;}
.qrow{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;}
/* chat */
.bub{max-width:78%;padding:10px 13px;border-radius:16px;font-size:13.5px;line-height:1.45;margin:0 16px 8px;}
.bub.me{background:var(--blue);color:#fff;margin-left:auto;border-bottom-right-radius:4px;}
.bub.them{background:var(--tint);margin-right:auto;border-bottom-left-radius:4px;}
.cbar{position:fixed;bottom:0;padding-bottom:calc(10px + env(safe-area-inset-bottom,0px))!important;left:50%;transform:translateX(-50%);width:390px;max-width:100vw;padding:10px 14px 16px;background:#fff;border-top:1px solid var(--divider);display:flex;gap:8px;align-items:center;z-index:35;}
.cbar input{flex:1;background:var(--tint);border:1px solid var(--border);border-radius:22px;padding:11px 15px;font-size:13.5px;outline:none;}
/* bottom nav */
.bottom-nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:390px;max-width:100vw;height:calc(62px + env(safe-area-inset-bottom,0px));padding:6px 4px env(safe-area-inset-bottom,0px);background:rgba(255,255,255,.97);backdrop-filter:blur(10px);border-top:1px solid var(--divider);display:flex;align-items:flex-start;justify-content:space-around;z-index:40;}
.nav{margin-top:5px;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:10px;font-weight:600;color:var(--dim);cursor:pointer;width:62px;position:relative;line-height:1.2;}
.nav.active{color:var(--ink);font-weight:800;}
.nav svg{color:var(--ink);}.nav.active svg{color:var(--blue);}
.nav .dot{position:absolute;bottom:-5px;width:4px;height:4px;border-radius:50%;background:var(--blue);}
.nav.mid{margin-top:0;width:84px;}
.circ{width:38px;height:38px;border-radius:50%;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;position:relative;}
.nav.mid .circ svg{color:#fff;}
.dash{position:absolute;width:8px;height:2px;background:var(--blue);border-radius:2px;}
.d1{left:-17px;top:4px;transform:rotate(-30deg);}.d2{left:-17px;bottom:6px;transform:rotate(30deg);}.d3{right:-17px;top:4px;transform:rotate(30deg);}.d4{right:-17px;bottom:6px;transform:rotate(-30deg);}
.me{width:24px;height:24px;border-radius:50%;overflow:hidden;border:1px solid var(--border);}.me svg{width:100%;height:100%;}
#toast{position:fixed;left:50%;bottom:84px;transform:translateX(-50%);background:#1a1a1a;color:#fff;padding:10px 16px;border-radius:12px;font-size:12.5px;font-weight:600;z-index:9999;opacity:0;transition:opacity .2s;pointer-events:none;max-width:80%;text-align:center;}
.post{cursor:pointer;}
.acts{gap:8px;}
.mb{display:flex;flex-direction:column;background:var(--tint);border:1px solid var(--border);border-radius:10px;padding:4px 9px;line-height:1.15;flex-shrink:0;}
.mb span{font-size:8.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--faint);}
.mb b{font-size:13px;font-weight:800;color:var(--text);}
.mb b.g,.big.g{color:#1fa463;}.mb b.y,.big.y{color:#b8841a;}.mb b.r,.big.r{color:var(--red);}
.lk{display:inline-flex;align-items:center;gap:4px;color:var(--ink);font-weight:800;}
.fl{font-size:9.5px;font-weight:800;color:var(--red);border:1px solid var(--red);border-radius:6px;padding:1px 5px;}
.trust{display:flex;align-items:center;gap:14px;margin:0 16px 12px;background:var(--card2);border:1px solid var(--border);border-radius:14px;padding:14px;}
.trust .big{font-size:30px;font-weight:800;letter-spacing:-.02em;}
.tinfo{flex:1;}.tinfo .t1{font-size:12px;font-weight:800;}.tinfo .t2{font-size:11px;color:var(--faint);line-height:1.4;}
.bar{height:6px;border-radius:3px;background:var(--card3);overflow:hidden;margin:6px 0;}.bar i{display:block;height:100%;border-radius:3px;}
.bar i.g{background:#1fa463;}.bar i.y{background:#dba52a;}.bar i.r{background:var(--red);}
.banner{margin:0 16px 12px;border:1px solid var(--red);background:#fdf1ee;color:var(--red);border-radius:12px;padding:10px 12px;font-size:12px;font-weight:600;line-height:1.45;}
.dpost{padding:0 16px;}
.dtitle{font-size:20px;font-weight:800;line-height:1.3;margin:12px 0 8px;}
.pbody{font-size:15px;line-height:1.6;color:#2b2b30;}
.cutwrap{position:relative;}.bl{filter:blur(6px);user-select:none;pointer-events:none;}
.fade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.1),#fff 85%);}
.ulock{text-align:center;margin:6px 0 14px;}
.hid{margin-top:12px;background:#eef4ff;border:1px solid #c9d8f6;border-radius:14px;padding:14px;font-size:14px;line-height:1.55;font-weight:600;word-break:break-word;}
.hid .hl{display:flex;gap:6px;align-items:center;font-size:11px;font-weight:800;color:var(--blue);text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;}
.esc{margin:14px 0;background:var(--card2);border:1px solid var(--border);border-radius:14px;padding:14px;font-size:13px;line-height:1.5;color:var(--dim);}
.esc .eh{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:800;color:var(--text);margin-bottom:6px;}
.vrow{display:flex;gap:8px;margin-top:10px;}.vrow .btn{flex:1;padding:12px 8px;}
.vbtn.up{background:#1fa463;}
.lnk{font-size:11.5px;color:var(--faint);text-align:center;margin-top:12px;text-decoration:underline;cursor:pointer;}
.votes{display:flex;gap:14px;font-size:12.5px;font-weight:700;color:var(--dim);margin:8px 0 12px;flex-wrap:wrap;}
.lockc{width:46px;height:46px;border-radius:14px;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.acct{background:var(--tint);border:1px solid var(--border);border-radius:16px;padding:14px;margin:12px 0;}
.acct .l{font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--faint);margin-top:8px;}.acct .l:first-child{margin-top:0;}
.acct .v{font-size:15px;font-weight:800;}.acct .num{font-size:25px;font-weight:800;letter-spacing:.05em;}
.sw{width:42px;height:24px;border-radius:14px;background:var(--card3);border:1px solid var(--border);position:relative;cursor:pointer;flex-shrink:0;}
.sw i{position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;background:#fff;transition:.15s;box-shadow:0 1px 2px rgba(0,0,0,.2);}
.sw.on{background:var(--blue);border-color:var(--blue);}.sw.on i{left:20px;}
.scrim{animation:fi .2s;}.sheet{animation:up .28s ease-out;}
@keyframes up{from{transform:translateY(100%)}to{transform:none}}@keyframes fi{from{opacity:0}to{opacity:1}}
.fld{width:100%;padding:14px;border:1px solid var(--border);background:var(--tint);border-radius:14px;font-size:14px;outline:none;margin-bottom:10px;color:var(--text);}
.err{color:var(--red);font-size:12px;margin:2px 0 10px;font-weight:600;}
.btn.mini{padding:7px 11px;font-size:11.5px;border-radius:9px;}
.chk{display:flex;align-items:center;gap:8px;padding:8px 0;font-size:12.5px;border-bottom:1px solid var(--divider);}.chk:last-child{border-bottom:none;}
.chk .ok{color:#1fa463;font-weight:800;}.chk .no{color:var(--red);font-weight:800;}.chk .need{color:var(--faint);font-size:11px;}
.bd{position:absolute;top:-7px;right:-7px;min-width:18px;height:18px;border-radius:9px;background:var(--red);color:#fff;font-size:10.5px;font-weight:800;font-style:normal;display:flex;align-items:center;justify-content:center;padding:0 5px;border:2px solid #fff;line-height:1;box-sizing:content-box;z-index:2;}
.bd.inl{position:static;border:none;}
.nav .ic{position:relative;display:flex;}.nav .ic .bd{top:-6px;right:-10px;}
.cc{position:relative;flex-shrink:0;padding:8px 15px;border-radius:18px;background:#fff;border:1px solid var(--border);font-size:13px;font-weight:500;color:var(--text);cursor:pointer;display:flex;align-items:center;}
.cc.on{border-color:var(--blue);color:var(--blue);font-weight:700;}
.cc.plus{padding:8px 11px;}.cc .bd{top:-8px;right:-5px;}
.chips{padding-top:9px;}.stories{padding-top:9px;}
