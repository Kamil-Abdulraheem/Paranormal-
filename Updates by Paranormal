 {id:1,by:'framer',t:'5h',m:'scene',title:'Dev (Make MCP Server, C',sub:'(Chat & Aishur Mezza',body:'Chat and Aishur Mezza walk through building an MCP server from scratch, then publishing the result as a live site you can share.',up:920,down:14,bm:410,com:638,eh:6.2},
