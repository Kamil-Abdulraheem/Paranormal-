 var t=ADMTAB,h='',ids=Object.keys(P).filter(k=>k!=='me'),ap=Object.keys(APPS).filter(k=>APPS[k].s==='pending'),od=DISP.filter(d=>d.s==='open').length,orp=REPORTS.filter(r=>r.s==='open').length;
 var btn=(l,f,c)=>'<div class="btn mini '+(c||'')+'" onclick="'+f+'">'+l+'</div>';
 if(t==='Overview'){h='<div class="stats"><div class="stat"><div class="v">'+ids.length+'</div><div class="l">Users</div></div><div class="stat"><div class="v">'+ids.filter(k=>P[k].topg).length+'</div><div class="l">Top Gs</div></div><div class="stat"><div class="v">'+ap.length+'</div><div class="l">Applications</div></div></div><div class="stats"><div class="stat"><div class="v">'+od+'</div><div class="l">Open disputes</div></div><div class="stat"><div class="v">'+orp+'</div><div class="l">Open reports</div></div><div class="stat"><div class="v">'+Object.keys(FLAG).filter(k=>FLAG[k]).length+'</div><div class="l">Flagged</div></div></div><div class="card" style="padding:14px"><div style="display:flex;align-items:center;gap:12px"><div style="flex:1"><div style="font-size:14px;font-weight:800">Phase 2 paid locks</div><div style="font-size:11.5px;color:var(--faint)">'+(CFG.locks?'Active since '+CFG.since:'Off. Every update is free to read.')+'</div></div><div class="sw'+(CFG.locks?' on':'')+'" onclick="toggleLocks()"><i></i></div></div></div>';}
 else if(t==='Top G'){h='<div class="sec"><span>Applications</span><span>'+ap.length+'</span></div>'+(ap.length?ap.map(k=>'<div class="card" style="padding:12px 14px"><div style="display:flex;align-items:center;gap:10px">'+av(k,40,1)+'<div style="flex:1"><div class="t1" style="font-size:14px;font-weight:800">'+esc(P[k].n)+'</div><div class="t2" style="font-size:11px;color:var(--faint)">Applied '+APPS[k].t+' ago</div></div></div><div style="margin:8px 0">'+checklist(k)+'</div><div style="display:flex;gap:8px">'+btn('Approve as Top G',"approveApp('"+k+"')",'blue')+btn('Decline',"rejectApp('"+k+"')",'line')+'</div></div>').join(''):'<div class="empty">No pending applications.</div>')+
  '<div class="note2">Approving an applicant who misses a requirement is allowed as an admin override.</div><div class="sec"><span>Current Top Gs</span></div><div class="card">'+ids.filter(k=>P[k].topg).map(k=>'<div class="row" style="cursor:default">'+av(k,36,1)+'<div class="info"><div class="t1">'+nm(k,0)+'</div><div class="t2">'+P[k].h+'</div></div>'+btn('Remove',"removeTopG('"+k+"')",'line')+'</div>').join('')+'</div>';}
 else if(t==='Seeker'){h=admSeeker();}else if(t==='Communities'){h=admCom();}else if(t==='Membership'){h=admMember();}else if(t==='Phase 2'){var held=POSTS.filter(x=>x.price>0&&!x.gone&&!lockOk(x)).length,live=POSTS.filter(x=>eff(x)>0).length;
  h='<div class="card" style="padding:14px"><div style="display:flex;align-items:center;gap:12px"><div style="flex:1"><div style="font-size:15px;font-weight:800">Paid locks (Phase 2)</div><div style="font-size:11.5px;color:var(--faint);margin-top:2px">'+(CFG.locks?'Active since '+CFG.since:'Off. Turn on at any time. It takes effect instantly.')+'</div></div><div class="sw'+(CFG.locks?' on':'')+'" onclick="toggleLocks()"><i></i></div></div></div><div class="stats"><div class="stat"><div class="v">'+live+'</div><div class="l">Live locked loops</div></div><div class="stat"><div class="v">'+held+'</div><div class="l">Held back by safety rules</div></div></div><div class="sec"><span>Safeguards built in</span></div><div class="card" style="padding:12px 14px;font-size:12.5px;line-height:1.7;color:var(--dim)">• Only Top Gs with ID, clean record, 30+ days and 85%+ score can lock<br>• Price limited to ₦200 to ₦500, two locks per 24 hours<br>• Free preview of 120+ characters, proof, and a clear label of what is locked<br>• Links and contacts locked only by Top Gs at 90%+<br>• Scam phrases and duplicates blocked<br>• Creator deposit of ₦1,000<br>• Staged payouts and 24 hour escrow<br>• Cast needs a reason; new accounts count less; weekly limit<br>• Locks vanish automatically if the creator gets flagged<br>• Saturated loops cannot be bought<br>• Content snapshot, no edits after sale</div>';}
 else if(t==='Disputes'){h='<div class="sec"><span>Cases</span><span>'+DISP.length+'</span></div>'+(DISP.length?DISP.map(d=>{var po=postById(d.post);return '<div class="card" style="padding:12px 14px"><div class="t1" style="font-size:13.5px;font-weight:800">'+esc(po?po.title:'Update')+'</div><div class="t2" style="font-size:11.5px;color:var(--faint);margin:3px 0 6px">Creator '+esc(P[d.by].n)+' · '+money(d.refund)+' refunded · '+d.t+'</div><div style="font-size:12px;color:var(--dim)">'+Object.keys(d.reasons).map(r=>esc(r)+' ×'+d.reasons[r]).join(' · ')+'</div>'+(d.s==='open'?'<div style="display:flex;gap:8px;margin-top:10px">'+btn('Uphold and keep flag',"upholdDisp("+d.id+")",'blue')+btn('Overturn',"overturnDisp("+d.id+")",'line')+'</div>':'<div class="badge" style="margin-top:8px">'+d.s+'</div>')+'</div>';}).join(''):'<div class="empty">No cases.</div>')+
  '<div class="sec"><span>Appeals</span><span>'+APPEALS.length+'</span></div>'+(APPEALS.length?APPEALS.map(a=>'<div class="card" style="padding:12px 14px;display:flex;align-items:center;gap:10px"><div style="flex:1"><div class="t1" style="font-weight:800">'+esc(P[a.by].n)+'</div><div class="t2" style="font-size:11.5px;color:var(--faint)">'+a.s+'</div></div>'+(a.s==='open'?btn('Lift flag',"appealAct("+a.id+",1)",'blue')+btn('Reject',"appealAct("+a.id+",0)",'line'):'')+'</div>').join(''):'<div class="empty">No appeals.</div>');}
 else if(t==='Reports'){h='<div class="sec"><span>Reports</span><span>'+REPORTS.length+'</span></div>'+REPORTS.map(r=>{var po=r.post?postById(r.post):null;return '<div class="card" style="padding:12px 14px"><div class="t1" style="font-size:13.5px;font-weight:800">'+(po?esc(po.title):'Payment issue')+'</div><div class="t2" style="font-size:11.5px;color:var(--faint);margin:3px 0 8px">'+esc(r.reason)+' · '+r.n+' report'+(r.n>1?'s':'')+(po?' · by '+esc(P[po.by].n):'')+'</div>'+(r.s==='open'?'<div style="display:flex;gap:8px;flex-wrap:wrap">'+btn(po?'Dismiss':'Resolve',"reportAct("+r.id+",'d')",'line')+(po?btn('Take down',"reportAct("+r.id+",'t')",'blue')+btn('Flag creator',"reportAct("+r.id+",'f')",'line'):'')+'</div>':'<div class="badge">'+r.s+'</div>')+'</div>';}).join('');}
 else if(t==='Users'){h='<div class="card">'+ids.map(k=>'<div class="row" style="cursor:default;flex-wrap:wrap">'+av(k,36,1)+'<div class="info"><div class="t1">'+nm(k,0)+'</div><div class="t2">'+P[k].h+(P[k].idv?' · ID verified':IDVQ[k]?' · ID requested':'')+(P[k].susp?' · suspended':'')+'</div></div><div style="display:flex;gap:6px;flex-wrap:wrap;width:100%;padding-left:48px;margin-top:2px">'+(P[k].idv?'':btn('Verify ID',"verifyUser('"+k+"')",'blue'))+(P[k].topg?btn('Remove Top G',"removeTopG('"+k+"')",'line'):btn('Make Top G',"makeTopG('"+k+"')",'blue'))+btn(P[k].susp?'Reinstate':'Suspend',"suspendUser('"+k+"')",'line')+(FLAG[k]?btn('Unflag',"unflag('"+k+"')",'line'):'')+'</div></div>').join('')+'</div>';}
 else {h='<div class="card" style="padding:14px;font-size:12.5px;line-height:1.7;color:var(--dim)"><div style="font-weight:800;color:var(--text);margin-bottom:4px">Protections in this prototype</div>• Admin credentials are stored only as salted PBKDF2 hashes, never as text<br>• 600,000 hashing rounds slow guessing<br>• Lockout after 5 failed attempts, growing each time<br>• Same error message for every failure<br>• Admin session lives in memory and ends after 10 minutes of inactivity<br>• Every admin action re-checks the role<br>• Names are escaped and a content security policy limits scripts</div><div class="banner" style="margin-top:0">A file that runs in the browser can never be fully secure. Anyone can copy the file and try to guess offline, and a 6-digit password falls quickly. Before launch, move sign-in to a server with a long passphrase, rate limiting and two-factor authentication, and change the password you shared here.</div><div style="padding:0 16px"><div class="btn" onclick="signOut()">Sign out</div></div>';}
 return '<div class="top">'+phd('Admin',{sub:'Only you can see this'})+'<div class="chips">'+ATABS.map(x=>'<div class="chip'+(x===t?' active':'')+'" onclick="ADMTAB=\''+x+'\';render()">'+x+'</div>').join('')+'</div></div><div class="feed">'+h+'</div>';}
function toggleLocks(){if(!need())return;var on=!CFG.locks;openSheet('<div style="font-size:17px;font-weight:800">'+(on?'Activate Phase 2?':'Turn off Phase 2?')+'</div><div style="font-size:12.5px;color:var(--dim);margin:6px 0 14px;line-height:1.5">'+(on?'Eligible Top Gs can lock extras for ₦200 to ₦500 under escrow and all anti-fraud rules. It takes effect immediately.':'All locked loops open for free. Purchases already in escrow continue to be honored. You can turn it back on at any time.')+'</div><div class="btn" onclick="setLocks('+on+')">'+(on?'Activate':'Turn off')+'</div><div class="lnk" onclick="closeSheet()">Cancel</div>');}
function setLocks(on){if(!need())return;CFG.locks=on;CFG.since=on?new Date().toLocaleString():'';closeSheet();toast(on?'Phase 2 is live':'Phase 2 is off');render();}
function approveApp(k){if(!need())return;P[k].topg=1;APPS[k].s='approved';toast(P[k].n+' is now a Top G');render();}
function rejectApp(k){if(!need())return;APPS[k].s='rejected';toast('Application declined');render();}
function makeTopG(k){if(!need())return;P[k].topg=1;toast(P[k].n+' is now a Top G');render();}
function removeTopG(k){if(!need())return;if(k==='me'){toast('You cannot remove yourself');return;}P[k].topg=0;toast('Top G removed');render();}
function verifyUser(k){if(!need())return;P[k].idv=1;delete IDVQ[k];toast('ID verified');render();}
function suspendUser(k){if(!need())return;P[k].susp=!P[k].susp;toast(P[k].susp?'Suspended':'Reinstated');render();}
function unflag(k){if(!need())return;delete FLAG[k];toast('Flag lifted');render();}
function upholdDisp(i){if(!need())return;DISP.filter(d=>d.id===i)[0].s='upheld';toast('Upheld. Flag stays and the deposit is forfeited');render();}
function overturnDisp(i){if(!need())return;var d=DISP.filter(x=>x.id===i)[0];d.s='overturned';delete FLAG[d.by];toast('Overturned. Creator unflagged');render();}
function appealAct(i,ok){if(!need())return;var a=APPEALS.filter(x=>x.id===i)[0];a.s=ok?'approved':'rejected';if(ok)delete FLAG[a.by];toast(ok?'Flag lifted':'Appeal rejected');render();}
function reportAct(i,a){if(!need())return;var r=REPORTS.filter(x=>x.id===i)[0],po=r.post?postById(r.post):null;if(a==='t'&&po){po.gone=1;r.s='taken down';}else if(a==='f'&&po){FLAG[po.by]=1;r.s='creator flagged';}else r.s='closed';toast('Done');render();}
function render(){saveScroll();chkExp();
 if(!SESSION){$('scr').innerHTML=(R.name==='rules'?'<div class="top"><div class="phd"><div class="iconbtn" onclick="R={name:\'home\'};render()">'+I.back(18)+'</div></div></div>'+sRules():sLogin());$('navwrap').innerHTML='';return;}
 var n=R.name,h='';
 if(n==='home')h=sHome();else if(n==='search')h=sSearch();else if(n==='profile')h=sProfile(R.id);else if(n==='create')h=sCreate();else if(n==='love')h=sLove();else if(n==='topgs')h=sTopgs();else if(n==='chats')h=sChats();else if(n==='chat')h=sChat(R.id);else if(n==='post')h=sPost(R.id);else if(n==='admin')h=sAdmin();else if(n==='topgapply')h=sTopgApply();else if(n==='wallet')h=sWallet();else if(n==='rules')h=sRules();else if(n==='seeker')h=sSeeker();else if(n==='cat')h=sCat(R.id);else if(n==='community')h=sCom(R.id);else if(n==='newcom')h=sNewCom();
 $('scr').innerHTML=h;$('navwrap').innerHTML=n==='chat'?'':navHtml();
 if(n==='home')$('feed').scrollTop=HS;
 if(n==='search'){doSearch();$('q').focus();}
 if(n==='chat'){var c=$('cf');c.scrollTop=c.scrollHeight;}
 if(n==='post'){var po=postById(R.id);if(eff(po)>0&&po.by!=='me'&&!PUR[R.id]&&!R.shown){R.shown=1;var pid=R.id;setTimeout(()=>{if(R.name==='post'&&R.id===pid&&!PUR[pid]&&!$('sheet'))openUnlock(pid);},450);}}
 tick();}
render();setInterval(tick,1000);
</script>
